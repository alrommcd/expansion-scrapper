GEMINI_API_KEY=your-gemini-api-key-here
# Optional - shared by three isolated enrichment layers, all degrade
# gracefully to "unavailable"/NULL for everything if this is unset, never
# a crash and never a guess:
#   - scoring/maps_enrichment.py: society Google Maps rating/review_count
#   - scoring/broker_contact_enrichment.py: broker phone/website/address
#     (2026-07-06), confidence-gated against Places API results
#   - scoring/society_enrichment.py: society official project page +
#     unit count/possession/RERA/sales contact (2026-07-06), same
#     confidence gate, one page fetch per confident match
# None of the locked deterministic metrics (corridor fit_score,
# society_fit_score's 3 non-rating inputs, broker_activity_score,
# absentee validated signals) depend on this key.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
